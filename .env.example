PORT=4100
HOST=0.0.0.0
WEB_HOST=0.0.0.0
WEB_PORT=5273
CONTROL_API_PROXY_TARGET=http://127.0.0.1:4100
CONTROL_STATE_PATH=./runtime/control-center.json

# Must match AUTHENTICATION_API_KEY used by the Evolution container.
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=replace-with-a-long-random-api-key

# Evolution runs in Docker and calls the host control API through this address.
EVOLUTION_PUBLIC_WEBHOOK_URL=http://host.docker.internal:4100
EVOLUTION_WEBHOOK_SECRET=replace-with-another-long-random-secret
EVOLUTION_AUTO_RESUME=true
EVOLUTION_POLL_INTERVAL=3s
EVOLUTION_CONNECT_RETRY_MIN_DELAY=15s

# S3-compatible media storage used by the control API.
MEDIA_S3_ENDPOINT=http://127.0.0.1:9000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=wa-control-media
MEDIA_S3_ACCESS_KEY=wa-control-media
MEDIA_S3_SECRET_KEY=replace-with-a-long-random-media-secret
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=67108864
MEDIA_MAX_AVATAR_BYTES=5242880
WA_CONTROL_MAX_MULTIPART_FILE_SIZE=64MB
WA_CONTROL_MAX_MULTIPART_REQUEST_SIZE=66MB

# API request logging. Body logging skips multipart file bytes.
REQUEST_LOG_ENABLED=true
REQUEST_LOG_INCLUDE_BODY=true
REQUEST_LOG_MAX_BODY_LENGTH=2048

# Docker Compose database credentials. Change before any shared deployment.
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=replace-with-a-long-random-database-password
EVOLUTION_POSTGRES_DB=evolution
